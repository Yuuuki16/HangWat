# backend をローカルで直接起動する場合は、ホストから公開された localhost:5440 に接続します。
# Docker Compose の backend コンテナでは、docker-compose.yml 側で db:5432 の DATABASE_URL を設定します。
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/hangwat_dev
# 統合テスト専用 DB。test:integration は resetTestDb() で全データを削除するため、開発 DB とは分けてください。
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5440/hangwat_test
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=your-secret-key-change-this
BACKEND_PORT=4000
SKIP_MIGRATE=false
DEPLOY_SMOKE_MODE=false

# ログインセッション Cookie の署名に使う秘密鍵です。必須。
# 各環境で十分に長いランダム値を設定してください（例: openssl rand -hex 32）。
SESSION_SECRET=

# Google Maps / Places API を使う backend API で必要です。
GOOGLE_MAPS_API_KEY=
