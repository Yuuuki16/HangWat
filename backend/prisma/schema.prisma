generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt   @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  events       Event[]
  eventMembers EventMember[]
}

model Event {
  id                   BigInt    @id @default(autoincrement())
  createdByUserId      BigInt
  title                String
  location             String?
  description          String?
  eventDate            DateTime? @db.Date
  confirmedCandidateId BigInt?   @unique
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  creator            User                @relation(fields: [createdByUserId], references: [id])
  confirmedCandidate ScheduleCandidate?  @relation("ConfirmedCandidate", fields: [confirmedCandidateId], references: [id])
  inviteTokens       EventInviteToken[]
  members            EventMember[]
  scheduleCandidates ScheduleCandidate[] @relation("EventCandidates")
}

model EventInviteToken {
  id          BigInt    @id @default(autoincrement())
  eventId     BigInt
  inviteToken String    @unique @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id])
}

model EventMember {
  id               BigInt   @id @default(autoincrement())
  eventId          BigInt
  userId           BigInt?
  displayName      String
  role             String
  memberType       String
  sessionTokenHash String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  event              Event               @relation(fields: [eventId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  scheduleCandidates ScheduleCandidate[]
  comments           Comment[]
  commentLikes       CommentLike[]

  @@unique([eventId, userId])
}

model ScheduleCandidate {
  id                BigInt   @id @default(autoincrement())
  eventId           BigInt
  createdByMemberId BigInt
  title             String
  location          String?
  description       String?
  startsAt          DateTime @db.Timestamptz(6)
  endsAt            DateTime @db.Timestamptz(6)
  status            String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  event            Event       @relation("EventCandidates", fields: [eventId], references: [id])
  createdByMember  EventMember @relation(fields: [createdByMemberId], references: [id])
  comments         Comment[]
  confirmedByEvent Event?      @relation("ConfirmedCandidate")
}

model Comment {
  id            BigInt   @id @default(autoincrement())
  candidateId   BigInt
  eventMemberId BigInt
  body          String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  candidate   ScheduleCandidate @relation(fields: [candidateId], references: [id])
  eventMember EventMember       @relation(fields: [eventMemberId], references: [id])
  likes       CommentLike[]
}

model CommentLike {
  id            BigInt   @id @default(autoincrement())
  commentId     BigInt
  eventMemberId BigInt
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  comment     Comment     @relation(fields: [commentId], references: [id])
  eventMember EventMember @relation(fields: [eventMemberId], references: [id])

  @@unique([commentId, eventMemberId])
}
