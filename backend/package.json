{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:integration": "node --env-file .env.test --import tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@prisma/client": "^6.11.1",
    "dotenv": "^16.4.7",
    "hono": "^4.8.4",
    "prisma": "^6.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0"
  }
}
