POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hangwat_dev

# ローカルで backend を直接起動する場合の接続先です。
# Docker Compose の backend コンテナでは docker-compose.yml 側で db:5432 の DATABASE_URL を組み立てます。
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/hangwat_dev

BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ログインセッション Cookie の署名に使う秘密鍵です。必須。
# 各環境で十分に長いランダム値を設定してください（例: openssl rand -hex 32）。
SESSION_SECRET=""